# Agente de newsletters — copia a .env y rellena. NUNCA subas el .env.

# Modelo (OpenAI)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4
MAX_CORRECCIONES=2

# Mailrelay (BetrésON) — fase 2
MAILRELAY_ACCOUNT=betreson.ipzmarketing.com
MAILRELAY_API_KEY=
MAILRELAY_SENDER_ID=1
MAILRELAY_GROUP_IDS=6

# Mailchimp (NATU) — fase 4
MAILCHIMP_DC=us13
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=269aad017f

# Base de datos (Neon) — fase 2
DATABASE_URL=

# Aprobaciones — fase 3 (mínimo 64 caracteres aleatorios)
APPROVAL_SECRET=

# Dominios permitidos para envíos de prueba
TEST_EMAIL_DOMAINS=natulaboratories.es,natuaromatic.com,betreson.com

# Solo si Chromium no está en la ruta por defecto
# PLAYWRIGHT_EXECUTABLE_PATH=/opt/pw-browsers/chromium
